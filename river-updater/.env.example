# Configuração de Ambiente do Serviço Backend Worker (river-monitor-worker)

# URL do seu projeto Supabase
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave Service Role do Supabase (OBRIGATÓRIA para gravação no banco com acesso administrativo)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Intervalo do Agendador Cron Interno (padrão: a cada 5 minutos => */5 * * * *)
CRON_INTERVAL=*/5 * * * *

# Versão do Worker para registro de Telemetria / Health Check
WORKER_VERSION=1.0.0

# URLs das Fontes Oficiais de Telemetria Hidrológica
OFFICIAL_SOURCE_URL=https://niveldosrios.guerreirosdohumaita.com.br/
GUAIBASOURCE_URL=https://nivelguaiba.com.br/
